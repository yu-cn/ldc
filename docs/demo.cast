[7.285, "o", "\r\n"]
[7.297, "o", "ldc — LDC 开发环境一键工具（裸命令只读快照；仓库在 ~/.ldc 指向的路径）\r\n"]
[7.309, "o", "\r\n"]
[7.321, "o", "  ldc | ldc status     只读快照（秒级）：远端差距 / dotfiles 漂移 / 身份 / root 阶段 / 最近 bootstrap\r\n"]
[7.333, "o", "  ldc plan             干跑预演（只读零变更）：重跑收敛会做什么——sudo/重跑前先看一眼\r\n"]
[7.345, "o", "  ldc sync             全量同步：fetch → pull → bootstrap → verify 全量\r\n"]
[7.357, "o", "  ldc verify [--full]  机器断言（默认 --quick；--full 含桌面域读值比对）\r\n"]
[7.369, "o", "  ldc audit            清单准入对账（只读）：自装未声明 / 已声明未装\r\n"]
[7.381, "o", "  ldc triage           dotfiles 落点漂移分流（逐文件 吸收/重渲染，交互式）\r\n"]
[7.393, "o", "  ldc log [N]          最近一次 bootstrap 日志尾部（默认 40 行）\r\n"]
[7.405, "o", "  ldc help [命令]      本总览或单命令详解（-h/--help 同义）\r\n"]
[7.417, "o", "  ldc version          版本（-v/--version 同义）\r\n"]
[7.617, "o", "\r\n"]
