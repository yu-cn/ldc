# ~/.bashrc — Linux 侧模板（LDC 仓库管理；以 WDC wsl/bashrc 为基础改造）
# 本文件是模板：bootstrap 渲染拷贝到 ~/.bashrc（ADR-0015）——改习惯改这里，ldc sync 后生效。
# 提示符 starship | 模糊搜索 fzf | 智能跳转 zoxide | ls→eza cat→bat grep→rg find→fd
# 机器私有段放 ~/.bashrc.local（见文件末尾；ADR-0003 机器自留地）

# 非交互 shell 直接返回（mise shims 的 PATH 先行——登录非交互 shell 经 .profile 间接 source 本文件也要能解析 node）
case ":$PATH:" in *":$HOME/.local/share/mise/shims:"*) ;; *) PATH="$HOME/.local/share/mise/shims:$PATH";; esac
case $- in *i*) ;; *) return;; esac

## ---------- 历史 ----------
HISTCONTROL=ignoreboth:erasedups   # 忽略重复和空格开头的命令，去重
HISTSIZE=50000
HISTFILESIZE=100000
HISTTIMEFORMAT='%F %T '
shopt -s histappend checkwinsize
# 每条命令执行后立即写入历史文件，多终端共享历史（在文件末尾统一挂载，见 PROMPT_COMMAND 守卫）

## ---------- Shell 行为增强 ----------
shopt -s globstar   # ** 递归匹配所有文件
shopt -s autocd     # 直接输入目录名即可 cd
shopt -s cdspell    # cd 拼写错误自动纠正
shopt -s dirspell   # 目录名拼写错误自动纠正

# 让 less 支持查看非文本文件
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

## ---------- PATH 与工具链 ----------
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH";; esac
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH";; esac
# uv
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
command -v uv >/dev/null 2>&1 && eval "$(uv generate-shell-completion bash)"
command -v uvx >/dev/null 2>&1 && eval "$(uvx --generate-shell-completion bash)"
# mise（Node 等语言工具链；shims 供非交互 shell 解析默认版，activate 供交互按目录切换——ADR-0016）
command -v mise >/dev/null 2>&1 && eval "$(mise activate bash)"
# 工具布局事实（fzf 键位等，ADR-0015）：install-user-tools 安装期探测写入 ~/.config/ldc/env.sh——
# 上游换布局只改安装器，本模板不再追路径；机器私有偏好放 ~/.bashrc.local（末尾加载可覆盖）
[ -f "$HOME/.config/ldc/env.sh" ] && . "$HOME/.config/ldc/env.sh"

## ---------- 现代工具别名 ----------
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --icons'
    alias ll='eza -la --icons --git'
    alias la='eza -a --icons'
    alias lt='eza --tree --icons'
else
    alias ls='ls --color=auto'
    alias ll='ls -alF'
    alias la='ls -A'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat'
command -v rg  >/dev/null 2>&1 && alias grep='rg' || alias grep='grep --color=auto'
command -v fd  >/dev/null 2>&1 && alias find='fd'

## ---------- WSL 便利垫片（探测门控，ADR-0017；非 WSL 零痕迹） ----------
if command -v clip.exe >/dev/null 2>&1; then
    pbcopy()  { clip.exe; }
    pbpaste() { powershell.exe -NoProfile -Command Get-Clipboard 2>/dev/null | tr -d '\r'; }
fi
command -v explorer.exe >/dev/null 2>&1 && open() { explorer.exe "${1:-.}"; }

# Git 快捷方式（走 gitconfig 里的 st/lg 别名）
alias gs='git st'
alias gl='git lg'
alias gd='git diff'
alias gco='git checkout'
alias ga='git add'
alias gc='git commit'
alias gp='git push'

# 其他
alias ..='cd ..'
alias ...='cd ../..'
alias reload='source ~/.bashrc && echo "bashrc 已重载"'

## ---------- fzf（Ctrl-R 搜历史 / Ctrl-T 搜文件 / Alt-C 跳目录） ----------
# 键位绑定与补全由 env.sh 接线（ADR-0015 事实外置）；这里只管搜索源与观感
if command -v fzf >/dev/null 2>&1; then
    # 用 fd 替代默认 find，更快且自动忽略 .git / node_modules
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git --exclude node_modules'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi
    export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
fi

## ---------- 补全 ----------
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

## ---------- 提示符与目录智能跳转 ----------
# 后备提示符（starship 不在时）
PS1='\[\e]0;\u@\h: \w\a\]\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
if [[ ${TERM:-} != "dumb" ]] && command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"   # z 跳转
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"

# starship 会整体替换 PROMPT_COMMAND，这里在所有钩子挂完后再补上即时写历史（幂等）
case ";${PROMPT_COMMAND:-};" in
    *";history -a;"*) ;;
    *) PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}history -a" ;;
esac

## ---------- 机器自留地（必须最末尾） ----------
# ~/.bashrc.local 是本机私有段（ADR-0003）：bootstrap 首次接管 ~/.bashrc 时从原文件迁移
# 标记块（# >>> ... >>> .. # <<< ... <<<）与 nvm 块而来，之后由机主自行维护、不入仓库。
# 放最末尾 → 机器段后加载，别名/环境可覆盖模板（如 gs=nvidia-smi 覆盖 gs='git st'）
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
