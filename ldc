#!/usr/bin/env bash
# ldc — LDC 开发环境一键工具（bash 实现的单一入口；体验约定对齐 WDC wdc.ps1）
# 裸命令不触发同步——长操作/改状态一律显式子命令；裸 ldc 给只读快照并提示下一步。
# 用法：
#   ldc | ldc status    只读快照（秒级）：与 origin/main 差距 / dotfiles 落点漂移 / 身份状态
#                         / root 阶段完成度 / 最近 bootstrap 判定行；--json 单行机器可读出口
#   ldc plan            干跑预演（只读零变更）：重跑收敛会做什么——sudo/重跑前先看一眼
#   ldc sync [--full]   日常同步：fetch → 落后则 pull（--ff-only）→ bootstrap → verify 全量；
#                         已收敛且声明未变（收敛账本，ADR-0021）跳过 bootstrap 仅 quick 断言
#                         秒级复核；--full 强制全量
#   ldc verify [--full] 机器断言；默认 --quick 秒级，--full 含桌面域 gsettings 读值比对
#   ldc audit           清单准入对账（只读）：自装未声明 / 已声明未装
#   ldc triage          dotfiles 落点漂移分流（交互式：逐文件 吸收/重渲染/跳过）
#   ldc log [N]         最近一次 bootstrap 日志尾部（默认 40 行）
#   ldc help [命令]     总览或单命令详解；-h/--help 同义
#   ldc version         版本（git describe）；-v/--version 同义
# 子命令后接 -h/--help 出该命令详解；退出码：0 成功 · 1 失败 · 2 有待办手工步骤（sync）
set -uo pipefail
# readlink -f 解析真实路径：本命令会经 ~/.local/bin/ldc 符号链接调用（bootstrap 安装），
# 不解析的话 BASH_SOURCE 是链接路径，定位不到 scripts/lib
SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=scripts/lib/common.sh
. "$SELF/scripts/lib/common.sh"

LDC_COMMANDS='status sync verify plan audit triage log help version'
cmd="${1:-status}"
[ $# -gt 0 ] && shift

ldc_version() {
    local v
    v=$(git -C "$SELF" describe --tags --always --dirty 2>/dev/null) || v=''
    printf '%s' "${v:-v0.0.0-unknown}"
}

print_topic_help() {
    # 单一印刷源（工单02）：`ldc help <topic>` 与「子命令 -h/--help」拦截共用，防两路口径漂移
    case "${1:-}" in
            status) echo 'ldc status — 只读快照（秒级，不改任何状态）
  远端差距（fetch 后与 origin/main 的领先/落后）、dotfiles 落点漂移（落点与模板内容比对，>0 提示 ldc triage）、
  身份文件是否生效（占位未填则「拒提交」护栏仍在）、root 阶段完成度、最近一次 bootstrap 判定行。
  裸 ldc 等价于 ldc status。--json 出单行机器可读出口（agent 判定不 scrape 颜色文本）。' ;;
            plan) echo 'ldc plan — 干跑预演（只读，零变更）
  按 bootstrap 的安装面与声明逐项比对，投影重跑收敛会做什么：
  [OK] 已就位 / [PLAN] 将变更 / [SKIP] 不适用 / [INFO] 需机主手工。
  与 verify 互补——verify 断言现状对不对，plan 投影跑一遍会发生什么；sudo/重跑前先看一眼。' ;;
            sync) echo 'ldc sync [--full] — 日常一键收敛
  顺序：fetch（失败即中止，不做盲同步）→ 落后则 pull --ff-only（本地领先/分叉一律中止交人工；
  钉版形态 detached HEAD 跳过仓库同步、仅收敛机器）→
  bootstrap 全阶段（sudo 需密码时末尾出交接命令）→ verify 全量。
  快速路径（ADR-0021）：收敛账本记「上次达终态时的 HEAD」，与当前 HEAD 一致且工作区干净——
  跳过 bootstrap 仅 verify --quick（秒级复核）；账本缺失/损坏/不匹配、工作区脏一律回退全量
  （假账本会假绿，宁可慢不可假绿）。--full 强制全量。
  任一段 FAIL 即非零退出；bootstrap 有待办（exit 2）时跳过 verify 并列出待办。' ;;
            verify) echo 'ldc verify [--full] — 机器断言
  五组断言：dotfiles 落点与模板一致（ADR-0015 内容断言）/ 身份 / 包清单核销（root 阶段完成度）
  / 语言栈 / 桌面域。默认 --quick（秒级）；--full 加桌面域 gsettings 读值比对。任一 FAIL 退出码 1。' ;;
            triage) echo 'ldc triage — dotfiles 落点漂移分流（交互式）
  机器侧工具会直改落点渲染物（VSCode / gh auth setup-git 等，ADR-0015）；本命令逐文件给出
  「吸收进模板（显式暂存）/ 还原为模板重渲染」的处置入口（ADR-0003 判据）。
  verify 的「落点与模板一致」断言 FAIL 时也会指向这里。' ;;
            audit) echo 'ldc audit — 清单准入对账（只读，exit 恒 0）
  两个方向：①自装未声明（apt-mark showmanual 对全部 .pkg 并集的差集，滤掉系统底座）——
  清单准入候选：每台机器都要的吸收进 .pkg，仅本机要的属机器自留；②已声明未装——收敛待办
  （root 交接 / install-packages.sh <组>）。这是对账报告不是断言，核销语义在 verify。' ;;
            log) echo 'ldc log [N] — 最近一次 bootstrap 日志尾部（默认 40 行）' ;;
            *) cat <<'EOF'
ldc — LDC 开发环境一键工具（裸命令只读快照；仓库在 ~/.ldc 指向的路径）

  ldc | ldc status     只读快照（秒级）：远端差距 / dotfiles 漂移 / 身份 / root 阶段 / 最近 bootstrap
  ldc plan             干跑预演（只读零变更）：重跑收敛会做什么——sudo/重跑前先看一眼
  ldc sync [--full]   日常同步：fetch → pull → bootstrap → verify 全量；已收敛且声明未变
                        走快速路径仅 quick 断言（收敛账本，ADR-0021）；--full 强制全量
  ldc verify [--full]  机器断言（默认 --quick；--full 含桌面域读值比对）
  ldc audit            清单准入对账（只读）：自装未声明 / 已声明未装
  ldc triage           dotfiles 落点漂移分流（逐文件 吸收/重渲染，交互式）
  ldc log [N]          最近一次 bootstrap 日志尾部（默认 40 行）
  ldc help [命令]      本总览或单命令详解（-h/--help 同义；子命令后接 -h 同理）
  ldc version          版本（-v/--version 同义）

  退出码：0 成功 · 1 失败 · 2 有待办手工步骤（sync）
EOF
            ;;
    esac
}

# --- 子命令校验在仓库定位之前：help/version 与友好报错不依赖 ~/.ldc 指针 ---
case $cmd in
    version|-v|--version)
        printf 'ldc %s\n' "$(ldc_version)"
        exit 0
        ;;
    help|-h|--help)
        print_topic_help "${1:-}"
        exit 0
        ;;
esac

suggest_cmd() {
    # 打错子命令时的「你是不是想输…」：先看唯一前缀命中，再看编辑距离 ≤2
    local input=$1 c hit=() bestd=99 d
    for c in $LDC_COMMANDS; do
        case $c in "$input"*) hit+=("$c") ;; esac
    done
    if [ "${#hit[@]}" -eq 1 ]; then printf '%s\n' "${hit[0]}"; return 0; fi
    local best=''
    for c in $LDC_COMMANDS; do
        d=$(awk -v a="$input" -v b="$c" 'BEGIN {
            m = length(a); n = length(b)
            if (m > n) { t = a; a = b; b = t; k = m; m = n; n = k }
            for (j = 0; j <= n; j++) prev[j] = j
            for (i = 1; i <= m; i++) {
                cur[0] = i
                for (j = 1; j <= n; j++) {
                    cost = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
                    x = prev[j] + 1; y = cur[j-1] + 1; z = prev[j-1] + cost
                    if (y < x) x = y; if (z < x) x = z
                    cur[j] = x
                }
                for (j = 0; j <= n; j++) prev[j] = cur[j]
            }
            print prev[n]
        }')
        if [ "$d" -le 2 ] && [ "$d" -lt "$bestd" ]; then best=$c; bestd=$d; fi
    done
    [ -n "$best" ] && printf '%s\n' "$best"
    return 1
}

if ! printf '%s\n' $LDC_COMMANDS | grep -qx "$cmd"; then
    sug=$(suggest_cmd "$cmd" || true)
    printf 'ldc: 未知子命令「%s」（可用：%s）\n' "$cmd" "$(printf '%s' "$LDC_COMMANDS" | sed 's/ / \/ /g')" >&2
    [ -n "$sug" ] && printf 'ldc: 你是想输「%s」吗？\n' "$sug" >&2
    exit 1
fi

# 子命令后接 -h/--help = 该命令详解（工单02）：到这里的 cmd 必是实体子命令
#（help/version 已在上一段 case 退出）；与 help 同理不依赖 ~/.ldc 指针
case "${1:-}" in
    -h|--help) print_topic_help "$cmd"; exit 0 ;;
esac

repo_ahead_behind() {
    # 输出 "ahead behind"（相对 origin/main）；无远端/无 HEAD 时 "0 0"
    local counts
    counts=$(git -C "$repo" rev-list --left-right --count 'HEAD...origin/main' 2>/dev/null || true)
    printf '%s\n' "${counts:-0 0}"
}

# --- 仓库定位：~/.ldc 指针（bootstrap 的 dotfiles 阶段写入）---
repo=$(head -n1 "$HOME/.ldc" 2>/dev/null || true)
if [ -z "$repo" ] || [ ! -f "$repo/bootstrap.sh" ]; then
    # 自描述失败（ADR-0015）：渲染拷贝后仓库缺席只影响 CLI 自身——报错即带恢复路径
    printf 'ldc: ~/.ldc 指针缺失或失效%s——仓库缺席/搬移后仅 CLI 受影响（dotfiles 已渲染为机器本地文件）\n' \
        "${repo:+（指向 $repo）}" >&2
    printf 'ldc: 恢复：git clone https://github.com/yu-cn/ldc.git <路径> && bash <路径>/bootstrap.sh（重写指针并重渲染落点）\n' >&2
    exit 1
fi

case $cmd in
    status)
        json=0
        if [ $# -gt 0 ]; then
            if [ "$1" = "--json" ]; then json=1; shift
            else printf 'ldc: status 不认得参数「%s」（可用：--json 机器可读出口）\n' "$1" >&2; exit 1; fi
        fi
        # 先算后印（工单01）：人读 step 序列与 --json 单行出口共用同一批判定，防两路口径漂移
        repo_state=ok ahead=0 behind=0
        if ! git -C "$repo" remote get-url origin >/dev/null 2>&1; then
            repo_state=no-origin
        elif ! git -C "$repo" symbolic-ref -q HEAD >/dev/null; then
            # 钉版形态（get.sh LDC_TAG 钉 tag 后 detached HEAD）：ahead/behind 对钉版机是误导，单列口径
            repo_state=detached
        elif GIT_TERMINAL_PROMPT=0 timeout 5 git -C "$repo" fetch --quiet 2>/dev/null; then
            # fetch 带 5s 超时与禁交互（快照秒级承诺——网络不佳不挂起）
            read -r ahead behind <<<"$(repo_ahead_behind)"
            if [ "${ahead:-0}" -gt 0 ] && [ "${behind:-0}" -gt 0 ]; then repo_state=diverged
            elif [ "${ahead:-0}" -gt 0 ]; then repo_state=ahead
            elif [ "${behind:-0}" -gt 0 ]; then repo_state=behind
            fi
        else
            # fetch 未达：按本地缓存的 origin/main 判读（json 口径 fetch-unreachable）
            read -r ahead behind <<<"$(repo_ahead_behind)"
            repo_state=fetch-unreachable
        fi
        drift_count=0
        drift_names=()
        while IFS='|' read -r name _tmpl target _gate mode; do
            if [ "$(dotfiles_entry_state "$repo/$_tmpl" "$HOME/$target" "$mode")" = drift ]; then
                drift_count=$((drift_count + 1)); drift_names+=("$name")
            fi
        done < <(dotfiles_map_entries)
        identity_ok=0; git_identity_ok && identity_ok=1
        root_done=0; root_stage_complete && root_done=1
        root_handoff=''
        [ "$root_done" -eq 0 ] && root_handoff=$(root_handoff_cmd "$repo")
        last_log='' last_verdict=''
        if log_file=$(latest_bootstrap_log); then
            last_log=$(basename "$log_file")
            last_verdict=$(grep -E '^\[(OK|FAIL|PENDING)\] ' "$log_file" | tail -n 1)
        fi
        # 参考资源对账提醒（ADR-0014；wsl-comfort 是参考资源非上游——2026-11-07 主人定性）：
        # 距上次 check-upstream 超 30 天提示补课——只提醒不巡检（对齐 wdc）
        upstream_days=-1
        ledger="$repo/docs/upstream-ledger.md"
        if [ -f "$ledger" ] \
           && last=$(grep -oE '\| 20[0-9]{2}-[0-9]{2}-[0-9]{2} ' "$ledger" | tr -d '| ' | sort -r | head -n 1) \
           && [ -n "$last" ]; then
            upstream_days=$(( ($(date +%s) - $(date -d "$last" +%s)) / 86400 ))
        fi
        if [ "$json" -eq 1 ]; then
            # 单行紧凑 JSON（工单01）：字符串一律过转义，手工拼装不引入 jq 运行时依赖（validate 红线）
            json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
            json_str_array() {  # 词表 → ["a","b"]（空词表 → []）
                local out='' item
                for item in "$@"; do
                    [ -n "$out" ] && out+=','
                    out+="\"$(json_escape "$item")\""
                done
                printf '[%s]' "$out"
            }
            hints=()
            case $repo_state in
                ahead|behind|diverged) hints+=('ldc sync') ;;
                fetch-unreachable) hints+=('远端 fetch 未达——按缓存判读；ldc sync 会先验 fetch 再动') ;;
            esac
            [ "$drift_count" -gt 0 ] && hints+=('ldc triage')
            [ "$identity_ok" -eq 0 ] && hints+=('编辑 ~/.gitidentity')
            [ "$root_done" -eq 0 ] && hints+=("root 交接：$root_handoff")
            [ "$upstream_days" -gt 30 ] && hints+=('bash scripts/check-upstream.sh 并记账 docs/upstream-ledger.md')
            last_json=null
            [ -n "$last_log" ] && last_json="{\"log\":\"$(json_escape "$last_log")\",\"verdict\":\"$(json_escape "$last_verdict")\"}"
            upstream_json=null
            [ "$upstream_days" -ge 0 ] && upstream_json="{\"days\":$upstream_days}"
            identity_b=false; [ "$identity_ok" -eq 1 ] && identity_b=true
            root_b=false; [ "$root_done" -eq 1 ] && root_b=true
            printf '{"tool":"ldc","version":"%s","command":"status","repo":{"state":"%s","ahead":%s,"behind":%s},"dotfiles":{"drift_count":%s,"drift_items":%s},"identity":{"ok":%s},"root_stage":{"complete":%s,"handoff":"%s"},"last_bootstrap":%s,"upstream_check":%s,"hints":%s}\n' \
                "$(ldc_version)" "$repo_state" "${ahead:-0}" "${behind:-0}" \
                "$drift_count" "$(json_str_array "${drift_names[@]}")" \
                "$identity_b" "$root_b" "$(json_escape "$root_handoff")" \
                "$last_json" "$upstream_json" "$(json_str_array "${hints[@]}")"
            exit 0
        fi
        phase 'ldc status · 只读快照'
        case $repo_state in
            no-origin) step '仓库' INFO '无 origin 远端（本地仓库形态）' ;;
            detached) step '仓库' INFO "钉版形态（detached at $(git -C "$repo" describe --tags --always 2>/dev/null || echo HEAD)）——升级重跑 get.sh 带新 tag" ;;
            fetch-unreachable)
                step '仓库' INFO "领先 ${ahead:-0} / 落后 ${behind:-0}（远端 fetch 未达：5s 超时/断网）——按上次 fetch 缓存判读；ldc sync 会先验 fetch 再动"
                ;;
            ok) step '仓库' OK '与 origin/main 一致' ;;
            *) step '仓库' INFO "领先 ${ahead:-0} / 落后 ${behind:-0}——ldc sync 同步之" ;;
        esac
        if [ "$drift_count" -eq 0 ]; then
            step 'dotfiles 漂移' OK '落点与模板一致'
        else
            step 'dotfiles 漂移' FAIL "$drift_count 项——ldc triage 分流"
        fi
        if [ "$identity_ok" -eq 1 ]; then
            step '身份文件' OK 'name/email 经 include 生效'
        else
            step '身份文件' FAIL '未填写——编辑 ~/.gitidentity（占位已生成）；不填则 git 拒绝提交'
        fi
        if [ "$root_done" -eq 1 ]; then
            step 'root 阶段' OK '包清单已核销'
        else
            step 'root 阶段' FAIL "未完成——交接命令：$root_handoff"
        fi
        if [ -n "$last_log" ]; then
            step '最近 bootstrap' INFO "$last_log → ${last_verdict:-（无判定行）}"
        else
            step '最近 bootstrap' INFO 'logs/ 尚无日志'
        fi
        if [ "$upstream_days" -ge 0 ]; then
            if [ "$upstream_days" -gt 30 ]; then
                step '参考资源检查' INFO "距上次 $upstream_days 天——bash scripts/check-upstream.sh 并记账 docs/upstream-ledger.md"
            else
                step '参考资源检查' OK "距上次 $upstream_days 天"
            fi
        fi
        ;;

    sync)
        # 完成 BEL（工单04）：trap EXIT 覆盖本分支全部收尾路径（快速路径 OK/FAIL、
        # bootstrap FAIL/PENDING、verify 收尾）——切走窗口结束有感知
        trap 'printf "\a"' EXIT
        full=0
        if [ $# -gt 0 ]; then
            if [ "$1" = "--full" ]; then full=1; shift
            else printf 'ldc: sync 不认得参数「%s」（可用：--full 强制全量）\n' "$1" >&2; exit 1; fi
        fi
        phase 'ldc sync · 仓库'
        if ! git -C "$repo" remote get-url origin >/dev/null 2>&1; then
            step '仓库' INFO '无 origin 远端——跳过仓库同步'
        elif ! git -C "$repo" symbolic-ref -q HEAD >/dev/null; then
            # 钉版形态（get.sh LDC_TAG 钉 tag 后 detached HEAD）：仓库冻结是有意状态，不 pull——只收敛机器
            step '仓库' INFO '钉版形态（detached HEAD，get.sh LDC_TAG）——跳过仓库同步，仅收敛机器；升级重跑 get.sh 带新 tag'
        else
            # fetch 失败即中止：不盲按陈旧 origin/main 判「一致」漏拉（10s 超时 + 禁交互）
            if ! GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$repo" fetch --quiet; then
                step '仓库' FAIL '远端 fetch 失败（网络/超时）——中止，不做盲同步'; exit 1
            fi
            read -r ahead behind <<<"$(repo_ahead_behind)"
            if [ "${ahead:-0}" -gt 0 ] && [ "${behind:-0}" -gt 0 ]; then
                step '仓库' FAIL "本地与远端分叉（领先 ${ahead} / 落后 ${behind}）——人工处理后再同步"; exit 1
            fi
            if [ "${ahead:-0}" -gt 0 ]; then
                step '仓库' FAIL "本地领先 ${ahead} 个提交未推送——先 push 再 ldc"; exit 1
            fi
            if [ "${behind:-0}" -gt 0 ]; then
                git -C "$repo" pull --ff-only || { step '仓库' FAIL 'pull --ff-only 失败，中止'; exit 1; }
                step '仓库' CHANGED "已拉取 ${behind} 个提交"
            else
                step '仓库' OK '已与 origin/main 一致'
            fi
        fi
        phase 'ldc sync · bootstrap'
        # 快速路径（ADR-0021）：账本 commit == HEAD 且工作区干净 → 跳过 bootstrap 仅 verify --quick。
        # 脏树守卫：未提交的声明编辑不改 HEAD——只判账本会漏，工作区脏一律全量；账本缺失/损坏/
        # 不匹配回退全量（假账本会假绿，宁可慢不可假绿）
        if [ "$full" -eq 0 ]; then
            head_sha=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
            if [ -n "$head_sha" ] \
               && [ -z "$(git -C "$repo" status --porcelain 2>/dev/null)" ] \
               && led_sha=$(converged_ledger_get) \
               && [ "$led_sha" = "$head_sha" ]; then
                step 'bootstrap' SKIP "快速路径——已收敛且声明未变（账本 commit ${head_sha:0:7} == HEAD，ADR-0021）"
                phase 'ldc sync · verify（快速路径 quick）'
                if bash "$repo/scripts/verify-machine.sh" --quick; then
                    step '快速路径' OK '全绿——声明有变（新提交）或 --full 时回全量'
                    exit 0
                else
                    step '快速路径' FAIL 'quick 断言未过——ldc sync --full 全量收敛排查'
                    exit 1
                fi
            fi
        fi
        rc=0
        bash "$repo/bootstrap.sh" || rc=$?
        if [ "$rc" -eq 1 ]; then
            step 'bootstrap' FAIL '未全绿——最近日志尾部（完整见 logs/）'
            log_file=$(latest_bootstrap_log) && tail -n 30 "$log_file"
            # 运行锁占用（ADR-0013）单列提示：判定行在日志即实锤；退出码保持 1（红线 7 词表内）
            if [ -n "${log_file:-}" ] && grep -q '已有一次收敛在跑' "$log_file" 2>/dev/null; then
                step '提示' INFO '本次失败因运行锁占用——另一收敛会话结束后再 ldc sync'
            fi
            exit 1
        fi
        if [ "$rc" -eq 2 ]; then
            step 'bootstrap' PENDING '有待办手工步骤（上方已列出）——完成后 ldc sync 复查'
            exit 2
        fi
        phase 'ldc sync · verify（全量）'
        bash "$repo/scripts/verify-machine.sh"
        exit $?
        ;;

    verify)
        vargs=--quick
        [ "${1:-}" = "--full" ] && vargs=
        # shellcheck disable=SC2086
        bash "$repo/scripts/verify-machine.sh" $vargs
        exit $?
        ;;

    plan)
        bash "$repo/scripts/plan-machine.sh"
        exit $?
        ;;

    audit)
        bash "$repo/scripts/audit-machine.sh"
        exit $?
        ;;

    triage)
        bash "$repo/scripts/triage-dotfiles-drift.sh"
        exit $?
        ;;

    log)
        lines=40
        if [ $# -gt 0 ]; then
            # 参数校验（工单03）：行数须为正整数——别让 tail 的报错口径泄露给调用方
            case $1 in
                ''|*[!0-9]*) printf 'ldc: log 参数须为行数（正整数），收到「%s」\n' "$1" >&2; exit 1 ;;
                *) lines=$1 ;;
            esac
        fi
        if ! log_file=$(latest_bootstrap_log); then
            step '日志' INFO 'logs/ 尚无 bootstrap 日志'
            exit 0
        fi
        step '日志' INFO "$log_file"
        tail -n "$lines" "$log_file"
        ;;
esac
